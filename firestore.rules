rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Orders collection: Open for reading and writing so customer devices can place orders
    // and kitchen/admin devices receive real-time updates and update status
    match /orders/{orderId} {
      allow read, write: if true;
    }
    
    // Reservations collection: Open for table booking and status updates
    match /reservations/{reservationId} {
      allow read, write: if true;
    }

    // Messages collection: Contact form / Fale Conosco customer messages
    match /messages/{messageId} {
      allow read, write: if true;
    }

    // Mail collection: Firebase Trigger Email extension
    match /mail/{mailId} {
      allow read, write: if true;
    }

    // Settings collection: Global branding, logo and emblem synchronized in real-time
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Menu Items collection: Individual menu items persisted and synchronized
    match /menu_items/{itemId} {
      allow read, write: if true;
    }

    // Gallery Posts collection: Individual gallery photos persisted and synchronized across all devices
    match /gallery_posts/{postId} {
      allow read, write: if true;
    }

    // Global match for settings and test connectivity
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
