# ----------------------------------------------------------------------
# Deolinda Pizzaria Napoletana - Single Page Application Router
# Compatible with Hostinger, Apache, LiteSpeed, OpenLiteSpeed, cPanel
# ----------------------------------------------------------------------

Options -MultiViews

<IfModule mod_dir.c>
  # Prevent Apache mod_dir from forcing 301 redirects on virtual routes
  DirectorySlash Off
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Direct SPA Routes: Always rewrite /cardapio, /cardápio and others directly to index.html
  RewriteRule ^(cardapio|cardápio|historia|história|galeria|localizacao|localização|admin)/?$ index.html [L,QSA]

  # 2. Never rewrite real existing static asset files (JS, CSS, PNG, SVG, JPG, WebP, WOFF2, etc.)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 3. Universal SPA Fallback: Any other non-file request rewrites to index.html
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Disable caching for index.html so updates and F5 refreshes are always immediate
  <Files "index.html">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </Files>
</IfModule>
